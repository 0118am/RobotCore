[Unit]
Description=RobotCore ROS 2 robot graph
After=network-online.target dev-robotcore-aboard.device nvargus-daemon.service zed_x_daemon.service IMU_Daemon.service robotcore-performance.service
Wants=network-online.target robotcore-performance.service
Requires=dev-robotcore-aboard.device nvargus-daemon.service zed_x_daemon.service IMU_Daemon.service
PartOf=robotcore-stack.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=robotcore
Group=robotcore
# ZED/AprilTag image processing needs NVIDIA render devices; USB CDC-ACM
# devices commonly retain the distro-managed dialout group in addition to the
# RobotCore udev ownership rule.
SupplementaryGroups=robotops video render dialout
EnvironmentFile=/etc/robotcore/edge.env
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=CYCLONEDDS_URI=file:///etc/robotcore/cyclonedds.xml
Environment=RCUTILS_LOGGING_BUFFERED_STREAM=1
WorkingDirectory=/var/lib/robotcore
StateDirectory=robotcore
StateDirectoryMode=0750
# Do not let localisation start against the package's sample map when the
# deployment has selected a managed map.  This check runs as the robot service
# account, so it also verifies that the selected revision is readable at boot.
ExecStartPre=/usr/bin/test -r ${ROBOTCORE_APRILTAG_MAP_FILE}
ExecStartPre=/usr/bin/test -r /etc/robotcore/cyclonedds.xml
ExecStartPre=/usr/bin/test -r /opt/ros/humble/lib/librmw_cyclonedds_cpp.so
ExecStartPre=/usr/bin/test -r ${ROBOTCORE_WORKSPACE}/install/setup.bash
ExecStartPre=/usr/bin/test -x ${ROBOTCORE_WORKSPACE}/install/robotcore_sensors/lib/robotcore_sensors/vio_tag_fusion_node
ExecStartPre=/usr/bin/test -x ${ROBOTCORE_WORKSPACE}/install/robotcore_control_cpp/lib/robotcore_control_cpp/command_authority
ExecStartPre=/usr/bin/test -r ${ZED_WORKSPACE}/install/setup.bash
ExecStartPre=/usr/bin/test -w ${ROS_LOG_DIR}
ExecStartPre=/usr/bin/test -w ${ROBOTCORE_RUN_ROOT}
# ROS/colcon setup scripts are not nounset-safe. Enable -u only after every
# overlay has been sourced so the launched graph still gets strict handling.
ExecStart=/usr/bin/bash -c 'set -eo pipefail; source /opt/ros/humble/setup.bash; source "${ROBOTCORE_WORKSPACE}/install/setup.bash"; set -u; exec ros2 launch robotcore_bringup robotcore_edge_system.launch.py enable_web_ui:=false enable_pool_tracking:=true enable_rl_policy_runtime:=true allow_rl_hardware:=true serial_port:="${ROBOTCORE_ABOARD_PORT}" apriltag_tag_map_file:="${ROBOTCORE_APRILTAG_MAP_FILE}" zed_workspace:="${ZED_WORKSPACE}"'
Restart=always
RestartSec=1
TimeoutStopSec=20
KillSignal=SIGINT
# Let the outer launch process stop its children in dependency order.  On a
# timeout systemd still kills every remaining process in the service cgroup.
KillMode=mixed
# Reserve six cores for the latency-sensitive graph; CPU 0-1 remain available
# to the browser, journald, networking, and kernel work.
CPUAffinity=2 3 4 5 6 7
CPUWeight=10000
IOWeight=1000
Nice=-10
OOMScoreAdjust=-750
LimitNICE=-10
LimitMEMLOCK=infinity
LimitNOFILE=1048576
TasksMax=infinity
TimerSlackNSec=1us
NoNewPrivileges=true
PrivateTmp=true
# Preserve /tmp isolation while exposing only the NVIDIA Argus and IMU-daemon
# IPC sockets that the ZED SDK needs to open the CSI camera. Do not bind the
# whole host /tmp.
BindReadOnlyPaths=/tmp/argus_socket
BindReadOnlyPaths=/tmp/imu_daemon.sock
ProtectHome=read-only
ReadWritePaths=/var/lib/robotcore /home/nvidia/robotcore_logs
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
