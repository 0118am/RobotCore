# Copy to /etc/robotcore/edge.env, set root:robotcore ownership and mode 0640.
ROBOTCORE_WORKSPACE=/home/nvidia/RobotCore/ros_ws
CONTROL_INTERFACE_WORKSPACE=/home/nvidia/ControlInterface
ZED_WORKSPACE=/home/nvidia/ros2_ws
ROBOTCORE_ABOARD_PORT=/dev/robotcore/aboard
# Keep this identical to apriltag_map.path in /etc/robotcore/host-manager.json.
# robotcore.service verifies that this existing managed map is readable before
# launching, then passes this exact path to apriltag_localization.
ROBOTCORE_APRILTAG_MAP_FILE=/etc/robotcore/apriltag_map.json
CONTROL_INTERFACE_HOST=127.0.0.1
CONTROL_INTERFACE_PORT=8080
# RobotCore and the web service run on the same host. Local-only discovery
# reduces DDS discovery traffic; set to 0 only when remote ROS tools are needed.
ROS_LOCALHOST_ONLY=1
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///etc/robotcore/cyclonedds.xml
ROS_LOG_DIR=/home/nvidia/robotcore_logs/ros
ROBOTCORE_RUN_ROOT=/home/nvidia/robotcore_logs/runs
