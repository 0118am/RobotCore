[Unit]
Description=ControlInterface browser operator UI
After=network-online.target robotcore-host-manager.service robotcore.service
Wants=network-online.target robotcore-host-manager.service robotcore.service
PartOf=robotcore-stack.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=robotcore
Group=robotcore
SupplementaryGroups=robotops
EnvironmentFile=/etc/robotcore/edge.env
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=CYCLONEDDS_URI=file:///etc/robotcore/cyclonedds.xml
Environment=RCUTILS_LOGGING_BUFFERED_STREAM=1
WorkingDirectory=/var/lib/robotcore
ExecStartPre=/usr/bin/test -r ${ROBOTCORE_WORKSPACE}/install/setup.bash
ExecStartPre=/usr/bin/test -r /etc/robotcore/cyclonedds.xml
ExecStartPre=/usr/bin/test -r /opt/ros/humble/lib/librmw_cyclonedds_cpp.so
ExecStartPre=/usr/bin/test -r ${CONTROL_INTERFACE_WORKSPACE}/install/setup.bash
ExecStartPre=/usr/bin/test -w ${ROS_LOG_DIR}
# ROS/colcon setup scripts are not nounset-safe. Enable -u only after every
# overlay has been sourced so the launched server still gets strict handling.
ExecStart=/usr/bin/bash -c 'set -eo pipefail; source /opt/ros/humble/setup.bash; source "${ROBOTCORE_WORKSPACE}/install/setup.bash"; source "${CONTROL_INTERFACE_WORKSPACE}/install/setup.bash"; set -u; exec ros2 launch control_interface web_operator.launch.py web_host:="${CONTROL_INTERFACE_HOST}" web_port:="${CONTROL_INTERFACE_PORT}" host_manager_socket:=/run/robotcore/host-manager.sock apriltag_map_file:="${ROBOTCORE_APRILTAG_MAP_FILE}"'
Restart=always
RestartSec=1
TimeoutStopSec=15
KillSignal=SIGINT
KillMode=control-group
# Keep browser/JPEG/HTTP work off the localisation cores.
CPUAffinity=0 1
CPUWeight=10
IOWeight=10
Nice=10
OOMScoreAdjust=500
LimitNOFILE=65536
TasksMax=512
TimerSlackNSec=50us
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/nvidia/robotcore_logs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
