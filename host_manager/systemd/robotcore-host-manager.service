[Unit]
Description=RobotCore local host-management daemon
Documentation=file:///opt/RobotCore/host_manager/README.md
After=local-fs.target
ConditionPathExists=/etc/robotcore/host-manager.json

[Service]
Type=simple
User=root
Group=robotops
RuntimeDirectory=robotcore
RuntimeDirectoryMode=0750
ExecStart=/opt/RobotCore/host_manager/bin/robotcore-host-manager --config /etc/robotcore/host-manager.json --socket /run/robotcore/host-manager.sock
Restart=on-failure
RestartSec=2
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
# Hide every home directory except the operator-visible RobotCore log tree.
ProtectHome=tmpfs
BindReadOnlyPaths=/home/nvidia/robotcore_logs
ProtectSystem=full
ReadWritePaths=/run/robotcore /etc/robotcore /var/lib/robotcore

[Install]
WantedBy=multi-user.target
