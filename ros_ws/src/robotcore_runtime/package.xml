<?xml version="1.0"?>
<package format="3">
  <name>robotcore_runtime</name>
  <version>0.1.0</version>
  <description>Runtime, safety, blackboard, task, and logging orchestration.</description>
  <maintainer email="maintainer@example.com">RobotCore Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>robotcore_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
