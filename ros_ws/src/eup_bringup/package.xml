<?xml version="1.0"?>
<package format="3">
  <name>eup_bringup</name>
  <version>0.1.0</version>
  <description>Launch and configuration package for EUPSystemInfraPack.</description>
  <maintainer email="maintainer@example.com">EUP System Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>eup_control</exec_depend>
  <exec_depend>eup_hardware</exec_depend>
  <exec_depend>eup_interfaces</exec_depend>
  <exec_depend>eup_policy</exec_depend>
  <exec_depend>eup_runtime</exec_depend>
  <exec_depend>eup_sensors</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
