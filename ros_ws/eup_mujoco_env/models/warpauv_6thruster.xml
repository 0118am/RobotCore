<mujoco model="warpauv_6thruster">
  <compiler angle="degree" coordinate="local"/>
  <!-- Three 1/180 s physics substeps are applied per 60 Hz action. -->
  <option timestep="0.005555555555555556" gravity="0 0 -9.81"/>

  <worldbody>
    <light name="top" pos="0 0 2"/>
    <geom name="water_plane" type="plane" size="6 6 0.01" pos="0 0 0" rgba="0.05 0.15 0.20 0.25"/>
    <body name="trajectory_target_marker" mocap="true" pos="0 0 -1.5">
      <geom name="trajectory_target_marker_geom" type="sphere" size="0.055" rgba="0.10 0.42 1.00 0.85" contype="0" conaffinity="0"/>
    </body>
    <body name="trajectory_actual_marker" mocap="true" pos="0 0 -1.5">
      <geom name="trajectory_actual_marker_geom" type="sphere" size="0.045" rgba="1.00 0.55 0.15 0.85" contype="0" conaffinity="0"/>
    </body>
    <!-- ROS-driven mocap dots: blue target trail, orange actual trail. -->
    <body name="trajectory_target_trail_00" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="0.10 0.42 1.00 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_target_trail_01" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="0.10 0.42 1.00 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_target_trail_02" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="0.10 0.42 1.00 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_target_trail_03" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="0.10 0.42 1.00 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_target_trail_04" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="0.10 0.42 1.00 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_target_trail_05" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="0.10 0.42 1.00 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_target_trail_06" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="0.10 0.42 1.00 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_target_trail_07" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="0.10 0.42 1.00 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_target_trail_08" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="0.10 0.42 1.00 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_target_trail_09" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="0.10 0.42 1.00 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_target_trail_10" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="0.10 0.42 1.00 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_target_trail_11" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="0.10 0.42 1.00 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_actual_trail_00" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="1.00 0.55 0.15 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_actual_trail_01" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="1.00 0.55 0.15 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_actual_trail_02" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="1.00 0.55 0.15 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_actual_trail_03" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="1.00 0.55 0.15 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_actual_trail_04" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="1.00 0.55 0.15 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_actual_trail_05" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="1.00 0.55 0.15 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_actual_trail_06" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="1.00 0.55 0.15 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_actual_trail_07" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="1.00 0.55 0.15 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_actual_trail_08" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="1.00 0.55 0.15 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_actual_trail_09" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="1.00 0.55 0.15 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_actual_trail_10" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="1.00 0.55 0.15 0.30" contype="0" conaffinity="0"/></body>
    <body name="trajectory_actual_trail_11" mocap="true" pos="0 0 -1.5"><geom type="sphere" size="0.018" rgba="1.00 0.55 0.15 0.30" contype="0" conaffinity="0"/></body>
    <body name="base_link" pos="0 0 -1.5">
      <freejoint/>
      <!-- Mass comes from Isaac WarpAUVEnvCfg.mass. Inertia is a rectangular
           prism estimate recorded in the source environment comments. -->
      <inertial pos="0 0 0" mass="22.701" diaginertia="0.37 0.97 1.19"/>
      <geom name="hull" type="box" size="0.35 0.20 0.10" rgba="0.02 0.08 0.12 1"/>
      <geom name="float_left" type="capsule" fromto="-0.30 0.18 0.08 0.30 0.18 0.08" size="0.045" rgba="0.92 0.92 0.86 1"/>
      <geom name="float_right" type="capsule" fromto="-0.30 -0.18 0.08 0.30 -0.18 0.08" size="0.045" rgba="0.92 0.92 0.86 1"/>

      <!-- Thruster order follows isaac-auv-env/thruster_dynamics.py exactly. -->
      <site name="drive_left" pos="-0.4127 0.1506 -0.0889" euler="0 0 0" size="0.025" rgba="1 0.4 0.2 1"/>
      <site name="drive_right" pos="-0.4127 -0.1506 -0.0889" euler="0 0 0" size="0.025" rgba="1 0.4 0.2 1"/>
      <site name="rear_left" pos="-0.3030 0.1461 -0.1587" euler="0 -45 90" size="0.025" rgba="0.2 0.6 1 1"/>
      <site name="rear_right" pos="-0.3030 -0.1461 -0.1587" euler="0 -45 -90" size="0.025" rgba="0.2 0.6 1 1"/>
      <site name="front_left" pos="0.0585 0.1461 -0.0540" euler="0 45 90" size="0.025" rgba="0.2 0.6 1 1"/>
      <site name="front_right" pos="0.0585 -0.1461 -0.0540" euler="0 45 -90" size="0.025" rgba="0.2 0.6 1 1"/>
      <camera name="front_camera" pos="0.42 0 -0.02" euler="0 -10 0" fovy="70"/>
    </body>
  </worldbody>

  <actuator>
    <!-- Site motor gear applies force along each site's local x-axis, matching
         the Isaac force construction before the source quaternions rotate it. -->
    <motor name="drive_left" site="drive_left" gear="1 0 0 0 0 0" ctrlrange="-160 160"/>
    <motor name="drive_right" site="drive_right" gear="1 0 0 0 0 0" ctrlrange="-160 160"/>
    <motor name="rear_left" site="rear_left" gear="1 0 0 0 0 0" ctrlrange="-160 160"/>
    <motor name="rear_right" site="rear_right" gear="1 0 0 0 0 0" ctrlrange="-160 160"/>
    <motor name="front_left" site="front_left" gear="1 0 0 0 0 0" ctrlrange="-160 160"/>
    <motor name="front_right" site="front_right" gear="1 0 0 0 0 0" ctrlrange="-160 160"/>
  </actuator>
</mujoco>
